APP_NAME=LearnSphere
APP_ENV=development

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256

# Local dev (no Postgres setup): use the bundled SQLite file after `alembic upgrade head`
DATABASE_URL=sqlite:///./learnsphere.db

# Postgres (password required if your server uses password auth):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/learnsphere