APP_NAME=LearnSphere
APP_ENV=development

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256

# ── PostgreSQL (default) ──────────────────────────────────────────────────────
# Option A: set individual variables (recommended for local dev / Docker)
POSTGRES_USER=learnsphere
POSTGRES_PASSWORD=learnsphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=learnsphere

# Option B: override with a full connection string (takes priority over POSTGRES_*)
# DATABASE_URL=postgresql://learnsphere:learnsphere@localhost:5432/learnsphere

# Connection pool (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ── SQLite (legacy / fallback) ────────────────────────────────────────────────
# Uncomment to use SQLite instead of PostgreSQL:
# DATABASE_URL=sqlite:///./learnsphere.db
