FROM python:3.11-slim

WORKDIR /app

# Install dependencies before copying app code (better layer caching).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code (.dockerignore excludes tests, .env, artifacts, etc.).
COPY . .

ENV PORT=8080
EXPOSE 8080

# Cloud Run terminates TLS; proxy-headers makes redirects use https (avoids mixed-content).
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
